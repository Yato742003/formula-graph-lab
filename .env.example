# Web application
GRAPH_API_URL=http://localhost:8000
GRAPH_API_SERVICE_TOKEN=replace-with-a-long-random-value

# Python Graph API
APP_ENV=development
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-a-strong-password
OPENAI_API_KEY=
# Proposal generation remains off until an operator supplies a model, per-million
# prices, a per-request cap, and a per-workspace UTC-day cap matching billing settings.
FGL_ENABLE_PROPOSAL_GENERATION=false
FGL_PROPOSAL_MODEL=
FGL_PROPOSAL_MAX_COST_USD=
FGL_PROPOSAL_DAILY_MAX_COST_USD=
FGL_PROPOSAL_INPUT_USD_PER_MILLION=
FGL_PROPOSAL_OUTPUT_USD_PER_MILLION=
FGL_PROPOSAL_MAX_OUTPUT_TOKENS=2000
SERVICE_TOKEN=replace-with-the-same-long-random-value
SEARCH_CURSOR_SECRET=replace-with-an-independent-long-random-value

# Research workers: disabled pending Sprint 4.5 release gates.
FGL_ENABLE_RESEARCH_CHECKS=false
# DSL candidate compilation does not execute checks; enable separately after the D2 gate.
FGL_ENABLE_RESEARCH_COMPILER=false
FGL_ENABLE_CANDIDATE_CHECKS=false
FGL_ENABLE_NUMERICAL_FIXTURE=false
FGL_ENABLE_RESEARCH_CASE=false
FGL_ENABLE_PROPOSALS=false
# Secret JSON array: identity, token (32+ ASCII chars), role, workspaces.
# Roles: proposer, compiler, verifier, experiment, evolution. No wildcard grants.
# Worker tokens must be independent of SERVICE_TOKEN and each other.
FGL_WORKER_IDENTITIES=[]
# Trusted controller only: independent 32-256 ASCII character HMAC secret.
FGL_RESEARCH_QUEUE_SECRET=
# Full local image ID from docker image inspect; tags are rejected.
FGL_SANDBOX_IMAGE=
