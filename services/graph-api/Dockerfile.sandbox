FROM python:3.12-slim@sha256:f77ac9e44ae96ef2c90b8053ea08c31f8be030f824196b0ae4db6d462c84e51f
RUN apt-get update -qq && apt-get install -y --no-install-recommends --only-upgrade \
    libpcre2-8-0=10.46-1~deb13u3 libssl3t64=3.5.7-1~deb13u3 \
    openssl=3.5.7-1~deb13u3 openssl-provider-legacy=3.5.7-1~deb13u3 && apt-get clean
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONNOUSERSITE=1
WORKDIR /opt/worker
RUN pip install --no-cache-dir sympy==1.14.0 mpmath==1.3.0 lxml==6.1.3
COPY app/formula_ast.py app/symbolic_worker.py app/numerical_worker.py app/experiment_worker.py app/research_case_worker.py ./app/
USER 65534:65534
CMD ["/usr/local/bin/python", "-B", "-m", "app.symbolic_worker"]
