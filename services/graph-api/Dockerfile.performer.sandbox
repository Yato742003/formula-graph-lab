FROM python:3.12-slim@sha256:423ed6ab25b1921a477529254bfeeabf5855151dc2c3141699a1bfc852199fbf
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONNOUSERSITE=1 \
    OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1
WORKDIR /opt/worker
RUN pip install --no-cache-dir \
    absl-py==2.1.0 \
    gin-config==0.5.0 \
    jax==0.4.35 \
    jaxlib==0.4.35 \
    numpy==1.26.4
COPY app/numerical_worker.py app/paper_artifact_manifest.py app/paper_attention_worker.py ./app/
USER 65534:65534
CMD ["/usr/local/bin/python", "-B", "-m", "app.paper_attention_worker"]
